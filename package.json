{
  "name": "tateti",
  "version": "0.0.1",
  "description": "Juego de Ta-Te-Ti",
  "productName": "Ta-Te-Ti",
  "author": "Leonardo Núñez <jorgebike.75@hotmail.com>",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "quasar dev",
    "build": "quasar build",
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,vue,css,html,md,json}\" --ignore-path .gitignore",
    "test": "echo \"No test specified\" && exit 0",
    "generar-apk": "npm run build && npm run cap:copy && npm run cap:android",
    "cap:copy": "npx cap copy android",
    "cap:sync": "npx cap sync android",
    "cap:android": "npx cap open android",
    "postinstall": "quasar prepare"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@quasar/extras": "^1.16.4",
    "@tabler/icons-webfont": "^3.35.0",
    "axios": "^1.2.1",
    "quasar": "^2.16.0",
    "vue": "^3.5.22",
    "vue-i18n": "^11.0.0",
    "vue-router": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@intlify/unplugin-vue-i18n": "^4.0.0",
    "@quasar/app-vite": "^2.1.0",
    "@vue/eslint-config-prettier": "^10.1.0",
    "autoprefixer": "^10.4.2",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.4.0",
    "postcss": "^8.4.14",
    "prettier": "^3.3.3",
    "vite-plugin-checker": "^0.11.0",
    "vue-eslint-parser": "^10.2.0"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22 || ^20",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  }
}
